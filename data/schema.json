{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/DanyH917/M291Dany-cours-web/data/schema.json",
  "title": "Projets DHgraphics",
  "description": "Structure de data.json : la liste des réalisations affichées dans la vitrine DHgraphics.",
  "type": "array",
  "minItems": 30,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "titre", "commune", "prixMoyen", "categorie", "description", "tags", "image"],
    "properties": {
      "id": { "type": "integer", "minimum": 1, "description": "Identifiant numérique unique." },
      "titre": { "type": "string", "minLength": 3, "maxLength": 80 },
      "client": { "type": "string", "minLength": 2 },
      "commune": { "type": "string", "minLength": 2, "description": "Commune du client, en Suisse romande." },
      "canton": { "type": "string", "enum": ["GE", "VD", "VS", "NE", "FR", "JU", "BE"] },
      "categorie": { "type": "string", "enum": ["Identité visuelle", "Logo", "Kit déco moto"], "description": "Sert aux puces de filtres." },
      "secteur": { "type": "string", "enum": ["Restauration", "Commerce", "Sport", "Association", "Artisanat", "Services"] },
      "description": { "type": "string", "minLength": 20, "maxLength": 200 },
      "prixMoyen": { "type": "number", "minimum": 0, "maximum": 10000, "description": "Prix indicatif en CHF (« dès … CHF »)." },
      "dureeSemaines": { "type": "integer", "minimum": 1, "maximum": 12 },
      "enVedette": { "type": "boolean", "description": "true = projet mis en avant sur l'accueil." },
      "annee": { "type": "integer", "minimum": 2020, "maximum": 2030 },
      "tags": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      },
      "pointsForts": { "type": "string", "minLength": 5 },
      "pointsFaibles": { "type": "string", "minLength": 5 },
      "image": { "type": "string", "pattern": "^images/[a-z0-9-]+\\.(jpg|webp|png)$" }
    }
  }
}
