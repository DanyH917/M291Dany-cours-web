{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Projets DHgraphics — version avancée (lieu et horaires)",
  "type": "array",
  "minItems": 1,
  "definitions": {
    "heure": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "plages": {
      "type": "array",
      "description": "Liste des plages d'ouverture du jour. Tableau vide = fermé.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ouverture", "fermeture"],
        "properties": {
          "ouverture": { "$ref": "#/definitions/heure" },
          "fermeture": { "$ref": "#/definitions/heure" }
        }
      }
    }
  },
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "titre", "commune", "prixMoyen", "coordonnees", "horaires"],
    "properties": {
      "id": { "type": "integer", "minimum": 1 },
      "titre": { "type": "string" },
      "client": { "type": "string" },
      "commune": { "type": "string" },
      "categorie": { "type": "string", "enum": ["Identité visuelle", "Logo", "Kit déco moto"] },
      "prixMoyen": { "type": "number", "minimum": 0 },
      "adresse": { "type": "string" },
      "coordonnees": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lat", "lng"],
        "description": "Limites approximatives de la Suisse romande.",
        "properties": {
          "lat": { "type": "number", "minimum": 45.8, "maximum": 47.6 },
          "lng": { "type": "number", "minimum": 5.9, "maximum": 7.8 }
        }
      },
      "horaires": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi", "dimanche"],
        "properties": {
          "lundi": { "$ref": "#/definitions/plages" },
          "mardi": { "$ref": "#/definitions/plages" },
          "mercredi": { "$ref": "#/definitions/plages" },
          "jeudi": { "$ref": "#/definitions/plages" },
          "vendredi": { "$ref": "#/definitions/plages" },
          "samedi": { "$ref": "#/definitions/plages" },
          "dimanche": { "$ref": "#/definitions/plages" }
        }
      }
    }
  }
}
